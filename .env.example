# Admin password for the panel UI.
# If unset, a random one is generated on boot and printed to the logs --
# it changes on every restart, so set this in production.
ADMIN_PASSWORD=change-me-to-something-long

# Signing key for session cookies. Without it, every restart logs you out.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Shared secret the VPS agent uses to pull config from /api/sync.
# Must match the --key passed to deploy/install.sh.
# Generate one with: openssl rand -hex 24
SYNC_KEY=

# Where the panel stores users and settings.
# Point this at a mounted volume, otherwise state is lost on every redeploy.
DATA_DIR=/data

# Port to listen on. Railway sets this automatically.
PORT=8080
